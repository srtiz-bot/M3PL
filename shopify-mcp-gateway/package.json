{
  "name": "shopify-mcp-gateway",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare-hosted multi-store Shopify MCP gateway with per-user OAuth, encrypted token storage, permission checks and audit logging.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:local": "wrangler d1 migrations apply shopify-mcp-gateway --local",
    "migrate:remote": "wrangler d1 migrations apply shopify-mcp-gateway --remote",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "wrangler": "^3.101.0"
  }
}
